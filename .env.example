# ══════════════════════════════════════════════════
# ValueScope — Environment Configuration
# Copy this file to backend/.env and fill in values
# ══════════════════════════════════════════════════

# ── AI Analysis (required for AI-powered valuations) ──
DEEPSEEK_API_KEY=
SERPER_API_KEY=

# ── Stock Data (optional, enhances coverage) ──
FMP_API_KEY=

# ── Valuation History ──
# Path to SQLite database for storing valuation records
# VS_DB_PATH=./data/valuations.db

# ── Portfolio Tracker (optional, local-only feature) ──
# Uncomment to enable portfolio tracking
# PORTFOLIO_DB_PATH=./data/portfolio.db
# BACKUP_DIR=./data/backups

# Capital tracking (for deposit-based return calculation)
# PORTFOLIOS=Main:portfolio.db
# DEPOSIT_CAPITAL=0
# DEPOSIT_FX_RATE=1.0

# ── Server Settings ──
# VS_AI_DAILY_LIMIT=50
# VS_CONTACT_EMAIL=

# ── Frontend ──
# NEXT_PUBLIC_API_URL=http://localhost:8000
